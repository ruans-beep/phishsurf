# Shared team password for the login gate.
APP_PASSWORD=change-me

# Long random string used to sign the auth cookie. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-too

# Postgres connection string. Railway injects this automatically when you
# add the Postgres plugin. For local dev you can point at a local Postgres,
# or omit this entirely to fall back to a local SQLite file.
DATABASE_URL=postgresql://user:password@localhost:5432/phishsurf

# Optional. Enables authenticated urlscan.io search (higher rate limits,
# access to private-quota results). Scans still run without it.
URLSCAN_API_KEY=

# Default lookback window (days) applied to certificate transparency and
# urlscan queries when a scan doesn't override it.
LOOKBACK_DAYS_DEFAULT=30

# How many resolving candidate hosts get their homepage fetched for content
# fingerprinting (Shopify markers, hotlinked assets, brand copy) per scan.
FETCH_TOP_N=25

# Thread pool size used for concurrent DNS/RDAP/page-fetch enrichment.
MAX_CONCURRENCY=5
